# CampusConnect configuration. Copy to .env and edit; every setting is optional.
#   cp .env.example .env
# Restart the server after changing it. Full reference: docs/DEPLOYMENT.md

# ── Server ────────────────────────────────────────────────────────────────────
# PORT=3000
# NODE_ENV=production        # hides demo mode, randomises the seeded password, skips demo data

# ── Storage ───────────────────────────────────────────────────────────────────
# CAMPUSCONNECT_DB=./data/campusconnect.db
# CAMPUSCONNECT_UPLOADS=./data/uploads

# ── Accounts & demo mode ──────────────────────────────────────────────────────
# Password given to seeded accounts that have none. In production, SET THIS BEFORE THE FIRST START.
# CAMPUSCONNECT_DEMO_PASSWORD=change-me
# Force one-click demo logins on (1) or off (0). Default: on outside production.
# CAMPUSCONNECT_DEMO=1
# Seed demo incidents/bookings/comments even in production.
# CAMPUSCONNECT_SEED_DEMO=1

# ── Google sign-in (needs internet) ───────────────────────────────────────────
# Create an OAuth 2.0 *Web* client at https://console.cloud.google.com/apis/credentials and add your
# origins (e.g. http://localhost:3000, http://localhost:5173) as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# Comma-separated email domains allowed to sign in with Google. Blank = any verified Google account
# (new people become Students).
GOOGLE_ALLOWED_DOMAINS=

# ── Networking ────────────────────────────────────────────────────────────────
# Allowed browser origins for CORS (same-origin requests always work).
# CORS_ORIGINS=https://campus.example.edu
# Set to 1 behind a reverse proxy so rate limiting sees real client IPs.
# TRUST_PROXY=1

# ── Optional Claude analysis in the incident drawer ───────────────────────────
# Everything else (triage, duplicates, risk, clusters, search) is offline and needs no key.
ANTHROPIC_API_KEY=
